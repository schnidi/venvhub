/*
 * Theme Name: One Dark (Atom Inspired)
 * Version: 2.3
 * Author: Viliam Schneider
 */

/* HLAVNÉ NASTAVENIA */
QWidget {
    background-color: #282c34;
    color: #abb2bf;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

/* ============================================= */
/* === CHECKBOXY A RADIO BUTTONY (KRÚŽKY) === */
/* ============================================= */

/* Štýl pre krúžky (Radio Buttons) */
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 9px;
    border: 2px solid #565c64; 
    background-color: #21252b;
}

QRadioButton::indicator:hover {
    border-color: #61afef; /* One Dark Modrá */
}

QRadioButton::indicator:checked {
    background-color: #61afef; 
    border: 2px solid #282c34;  /* Kontrastný vnútorný okraj */
}

/* Štýl pre štvorčeky (Checkboxes) */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #565c64;
    background-color: #21252b;
    border-radius: 3px;
}

QCheckBox::indicator:hover {
    border-color: #61afef;
}

/* Ak nemáš obrázok fajky, toto vytvorí aspoň vizuálnu zmenu */
QCheckBox::indicator:checked {
    background-color: #61afef;
    border: 2px solid #282c34;
}

/* ============================================= */
/* === TLAČIDLÁ (BUTTONS) === */
/* ============================================= */

QPushButton {
    background-color: #353b45;
    color: #d7dae0;
    border: 1px solid #181a1f;
    border-radius: 4px;
    padding: 5px 15px;
}

QPushButton:hover {
    background-color: #3e4451;
    border-color: #61afef;
}

QPushButton:pressed {
    background-color: #4b5263;
    color: white;
}

/* STAV OZNAČENÉHO TLAČIDLA (KEĎ JE AKTÍVNE) */
QPushButton:checked {
    background-color: #61afef !important;
    color: #282c34 !important;
    border: 1px solid #ffffff;
    font-weight: bold;
}

/* Špecifické tlačidlá na lište */
#ProjectMiniBar QPushButton {
    background-color: transparent;
    border: 1px solid transparent;
}

#ProjectMiniBar QPushButton:checked {
    background-color: #2c313a;
    border: 1px solid #61afef;
}

/* ============================================= */
/* === ZÁLOŽKY (TABS) === */
/* ============================================= */
QTabWidget::pane {
    border: 1px solid #181a1f;
}

QTabBar::tab {
    background-color: #21252b;
    color: #6b727c;
    padding: 8px 15px;
    border: 1px solid #181a1f;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #282c34;
    color: #d7dae0;
    border-bottom: 2px solid #61afef;
    font-weight: normal;
}

/* ============================================= */
/* === VSTUPNÉ POLIA (INPUTS) === */
/* ============================================= */
QLineEdit, QComboBox {
    background-color: #21252b;
    border: 1px solid #181a1f;
    border-radius: 3px;
    padding: 4px;
    color: #d7dae0;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #61afef;
    background-color: #21252b;
}

/* TABUĽKY A VÝBER */

/* ============================================= */
/* === KOMPLETNÁ ÚPRAVA TABUĽKY (QTableWidget) === */
/* ============================================= */

QTableWidget {
    background-color: #282c34;   
    border: 1px solid #181a1f;
    gridline-color: transparent; 
    outline: none;               
    selection-background-color: #2c313c; 
}

/* Hlavička tabuľky */
QHeaderView::section {
    background-color: #21252b;
    padding: 6px;
    border: 1px solid #181a1f;
    font-weight: bold;
    color: #5c6370;
}

/* Štýl pre bunky a riadky */
QTableWidget::item {
    padding: 2px;
    border: none;                
    background-color: transparent;
}

/* 1. JEMNÝ HOVER */
QTableWidget::item:hover {
    background-color: #2c313a;   
    color: #ffffff;
}

/* 2. PODSVIETENIE CELÉHO VYBRANÉHO RIADKA */
QTableWidget::item:selected {
    background-color: #3e4451;   
    color: #ffffff;
    border: none !important;     
    border-left: none !important; 
}

/* ============================================= */
/* === OPRAVA TLAČIDIEL (WIDGETOV) V TABUĽKE === */
/* ============================================= */

QTableWidget QWidget {
    background-color: transparent;
}

QTableWidget QPushButton {
    background-color: #353b45;
    color: #abb2bf;
    border: 1px solid #181a1f;
    border-radius: 4px;
    margin: 1px;         
    padding: 0px;        
    
    min-width: 22px;     
    max-width: 22px;
    min-height: 22px;    
    max-height: 22px;

    font-size: 10px;     
    qproperty-iconSize: 14px 14px; 
}

QTableWidget QPushButton#btn_play, 
QTableWidget QPushButton#btn_stop {
    font-size: 10px !important;
}

QTableWidget QPushButton:hover {
    background-color: #3e4451;
    border: 1px solid #61afef;
    color: #ffffff;
}

/* FIX FARIEB PRE PLAY / STOP IKONY (One Dark paleta) */
QTableWidget QPushButton#btn_play {
    color: #98c379 !important;   /* One Dark Zelená */
}

QTableWidget QPushButton#btn_stop {
    color: #e06c75 !important;   /* One Dark Červená */
}

QTableWidget QPushButton#btn_mgr, 
QTableWidget QPushButton#btn_refresh {
    color: #61afef !important;   /* One Dark Modrá */
}

QTableWidget QHeaderView::corner-button {
    background-color: #21252b;
    border: none;
}

QTextEdit {
    background-color: #282c34;
    color: #abb2bf;
    border: 1px solid #181a1f;
}

/* ============================================= */
/* === OHRANIČENIE FRAMELESS OKIEN (POP-UPS) === */
/* ============================================= */
#VSCodeUserWindow, 
#LocalPackagesWindow, 
#PipManagerWindow, 
#VenvTreeWindow, 
#PipEWindow, 
#AboutDialog, 
#ProgressDialog, 
#MasterManager, 
#BuildLogDialog, 
#CustomMessageBox, 
#PackageSecurityAuditDialog, 
#SecurityFixLogDialog, 
#SnapshotWindow, 
#SnapshotActionLogDialog {
    background-color: #282c34;
    border: 1px solid #61afef; /* One Dark modrý akcent na oknách */
}

#ProjectMiniBar {
    background-color: #282c34;
    border: none; 
}

#QuickSettings {
    background-color: #282c34;
    border: none; 
}

QPushButton#btn_about {
    qproperty-icon: url({{CORE_THEMES_DIR}}/icon/about_white.svg);
    qproperty-iconSize: 18px 18px;
    background-color: transparent;
    border: none;
}

QPushButton#btn_about:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
}

QPushButton#btn_toggle_mode {
    qproperty-icon: url({{CORE_THEMES_DIR}}/icon/icon_mode_widget.svg);
    qproperty-iconSize: 20px 20px;
    background-color: transparent;
    border: none;
}

QPushButton#btn_toggle_mode:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
}

QPushButton#btn_vscode {
    qproperty-icon: url({{CORE_THEMES_DIR}}/icon/vscode/vscode5.svg);
    qproperty-iconSize: 18px 18px;
    background-color: transparent;
    border: none;
}

QPushButton#btn_vscode:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
}

/* Widget hover efekt */

#ProjectMiniBar #btn_play, 
#ProjectMiniBar #btn_stop, 
#ProjectMiniBar #btn_open_mgr, 
#ProjectMiniBar #btn_mgr,      
#ProjectMiniBar #btn_refresh,
#ProjectMiniBar #btn_pin,
#ProjectMiniBar #btn_settings {
    background-color: transparent;
    border: none;
    border-radius: 4px;
}

#ProjectMiniBar #btn_play:hover, 
#ProjectMiniBar #btn_stop:hover, 
#ProjectMiniBar #btn_open_mgr:hover, 
#ProjectMiniBar #btn_mgr:hover, 
#ProjectMiniBar #btn_refresh:hover,
#ProjectMiniBar #btn_pin:hover,
#ProjectMiniBar #btn_settings:hover {
    background-color: rgba(255, 255, 255, 0.05) !important;
}

/* STAV, KEĎ JE PRIPÍNAČKA AKTÍVNA (ZAPNUTÁ) */
#ProjectMiniBar #btn_pin:checked {
    background-color: #61afef; 
    border: 1px solid #181a1f;
}

#ProjectMiniBar #btn_pin:checked:hover {
    background-color: #72bef2; 
}

/* Tlačidlo Aktualizácie (GitHub Update) */
QPushButton#btn_update_github {
    qproperty-icon: url({{CORE_THEMES_DIR}}/icon/update/github_update_white.svg);
    qproperty-iconSize: 18px 18px;
    background-color: transparent;
    border: none;
}

QPushButton#btn_update_github:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
}

/* Ikona pre VS Code podľa témy */
QPushButton#btn_vscode[ide_type="vscode"] {
    qproperty-icon: url({{CORE_THEMES_DIR}}/icon/vscode/vscode5.svg);
}

/* Ikona pre Cursor podľa témy */
QPushButton#btn_vscode[ide_type="cursor"] {
    qproperty-icon: url({{CORE_THEMES_DIR}}/icon/cursor/cursor_icon.svg);
}

/* ======================================================== */
/* 1. KRÍŽIK X V LIŠTE                                      */
/* ======================================================== */
QPushButton#btn_close {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    min-width: 45px;
    max-width: 45px;
    min-height: 32px;
    max-height: 32px;
    color: #cccccc;
}

QPushButton#btn_close:hover {
    background-color: #e81123;  /* Klasický červený krížik pri prejdení myšou */
    color: #ffffff;
    border: none;
}

/* ======================================================== */
/* 2. TLAČIDLÁ DIALÓGU (OK, Áno, Nie) - bez :not()         */
/* ======================================================== */
#CustomMessageBox QPushButton {
    background-color: #333333;
    color: #eeeeee;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 4px 12px;
    min-width: 60px;
}

#CustomMessageBox QPushButton:hover {
    background-color: #444444;
    border-color: #007acc;
    color: #ffffff;
}

#CustomMessageBox QPushButton:pressed {
    background-color: #005a9e;
    color: #ffffff;
}

/* Krížik v dialógu - musí byť PO vyššie uvedených pravidlách */
#CustomMessageBox QPushButton#btn_close {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    min-width: 45px;
    max-width: 45px;
    min-height: 32px;
    max-height: 32px;
    color: #cccccc;
}

#CustomMessageBox QPushButton#btn_close:hover {
    background-color: #e81123;
    color: #ffffff;
    border: none;
}

/* ========================================================================= */
/* === BEZPEČNOSTNÝ AUDIT (PackageSecurityAuditDialog & SecurityFixLogDialog) */
/* ========================================================================= */

/* 1. Hlavné okná auditu */
#PackageSecurityAuditDialog, #SecurityFixLogDialog {
    background-color: #282c34;
    border: 1px solid #61afef;
}

/* 2. Strom zraniteľností v audite (QTreeWidget) */
#PackageSecurityAuditDialog QTreeWidget {
    background-color: #21252b;
    color: #abb2bf;
    border: 1px solid #181a1f;
    border-radius: 4px;
    outline: none;
}

#PackageSecurityAuditDialog QTreeWidget::item {
    padding: 5px 2px;
    border: none;
    background-color: transparent;
}

#PackageSecurityAuditDialog QTreeWidget::item:hover {
    background-color: #2c313a;
    color: #ffffff;
}

#PackageSecurityAuditDialog QTreeWidget::item:selected {
    background-color: #3e4451;
    color: #ffffff;
}

/* Hlavička stromu */
#PackageSecurityAuditDialog QHeaderView::section {
    background-color: #21252b;
    color: #5c6370;
    padding: 6px;
    border: 1px solid #181a1f;
    font-weight: bold;
}

/* 3. Rozdeľovač (Splitter handle) */
#PackageSecurityAuditDialog QSplitter::handle {
    background-color: #181a1f;
    width: 3px;
}

#PackageSecurityAuditDialog QSplitter::handle:hover {
    background-color: #61afef;
}

/* 4. Bočný detailný panel (QTextEdit) */
#PackageSecurityAuditDialog QTextEdit {
    background-color: #21252b;
    color: #abb2bf;
    border: 1px solid #181a1f;
    border-radius: 4px;
    padding: 10px;
}

/* 5. Tlačidlá filtra na hornej lište */
#PackageSecurityAuditDialog QPushButton:checked {
    background-color: #61afef !important;
    color: #282c34 !important;
    border: 1px solid #ffffff;
    font-weight: bold;
}

/* 6. Zelené akčné tlačidlo aktualizácie balíčka (One Dark Zelená) */
#PackageSecurityAuditDialog QPushButton#btn_fix_package {
    background-color: #2c3e2e;
    color: #98c379;
    border: 1px solid #98c379;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
    min-height: 28px;
}

#PackageSecurityAuditDialog QPushButton#btn_fix_package:hover {
    background-color: #98c379;
    color: #282c34;
}

#PackageSecurityAuditDialog QPushButton#btn_fix_package:disabled {
    background-color: #21252b;
    color: #5c6370;
    border-color: #3e4451;
}

/* 7. Vyskakovacie okno so živým logom inštalácie */
#SecurityFixLogDialog QTextEdit {
    background-color: #1e2227;
    color: #98c379; /* Monospace výstup v One Dark zelenej */
    font-family: Consolas, 'Courier New', monospace;
    font-size: 11px;
    border: 1px solid #181a1f;
    border-radius: 4px;
    padding: 8px;
}
